model Tournament {
  id           String    @id @default(cuid())
  organizerId  String
  organizer    User      @relation(fields: [organizerId], references: [id])
  hostTurfId   String?
  hostTurf     Turf?     @relation(fields: [hostTurfId], references: [id])
  name         String
  entryFee     Decimal   @db.Decimal(10, 2)
  prizeInfo    String?
  rules        String?
  status       String    @default("DRAFT")
  startDate    DateTime  @db.Date
  endDate      DateTime  @db.Date
  createdAt    DateTime  @default(now())

  teamEntries TournamentTeamEntry[]
  matches     TournamentMatch[]

  @@map("tournaments")
}

model TournamentTeamEntry {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  teamId       String
  team         Team       @relation(fields: [teamId], references: [id])
  seed         Int?

  @@unique([tournamentId, teamId])
  @@map("tournament_team_entries")
}

model TournamentMatch {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  matchId      String?    @unique
  match        Match?     @relation(fields: [matchId], references: [id])
  turfId       String
  turf         Turf       @relation(fields: [turfId], references: [id])
  round        Int
  teamAId      String?
  teamA        Team?      @relation("TournamentMatchTeamA", fields: [teamAId], references: [id])
  teamBId      String?
  teamB        Team?      @relation("TournamentMatchTeamB", fields: [teamBId], references: [id])
  scheduledAt  DateTime

  @@map("tournament_matches")
}
