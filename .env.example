NODE_ENV=development
PORT=5000

# Database (Prisma 7 reads the connection URL via prisma.config.ts + the
# driver adapter — this var is still what both of those read from)
DATABASE_URL="postgresql://user:password@localhost:5432/turfxi?schema=public"

# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_another_long_random_string
JWT_REFRESH_EXPIRES_IN=7d

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Redis (BullMQ + Socket.io adapter + caching)
REDIS_URL=redis://localhost:6379

# Payments (SSLCommerz sandbox)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_SANDBOX=true

# Frontend origin (for CORS + socket connections)
CLIENT_URL=http://localhost:3000
