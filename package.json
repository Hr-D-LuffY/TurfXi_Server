{
	"name": "turfxi-backend",
	"version": "0.1.0",
	"description": "TurfXI backend API — Express + TypeScript + Prisma + PostgreSQL",
	"main": "src/server.ts",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/server.ts",
		"start": "tsx src/server.ts",
		"worker:dev": "tsx watch src/jobs/worker.ts",
		"worker:start": "tsx src/jobs/worker.ts",
		"typecheck": "tsc --noEmit",
		"prisma:generate": "prisma generate",
		"prisma:migrate": "prisma migrate dev"
	},
	"dependencies": {
		"@prisma/adapter-pg": "^7.8.0",
		"@prisma/client": "^7.8.0",
		"@socket.io/redis-adapter": "^8.3.0",
		"bcryptjs": "^3.0.3",
		"bullmq": "^6.2.0",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.6",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"express-rate-limit": "^8.6.2",
		"helmet": "^8.2.0",
		"ioredis": "^6.0.0",
		"jsonwebtoken": "^9.0.3",
		"morgan": "^1.11.0",
		"passport": "^0.7.0",
		"passport-google-oauth20": "^2.0.0",
		"passport-jwt": "^4.0.1",
		"pg": "^8.22.0",
		"prisma": "^7.8.0",
		"socket.io": "^4.8.3",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/bcryptjs": "^2.4.6",
		"@types/cookie-parser": "^1.4.10",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/morgan": "^1.9.10",
		"@types/node": "^26.1.1",
		"@types/passport": "^1.0.17",
		"@types/passport-google-oauth20": "^2.0.17",
		"@types/passport-jwt": "^4.0.1",
		"tsx": "^4.23.0",
		"typescript": "^7.0.2"
	}
}
